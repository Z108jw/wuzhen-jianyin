# OpenAI-compatible chat-completions endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Set this to the externally reachable URL after starting a tunnel.
APP_BASE_URL=http://127.0.0.1:8000
MAX_FILE_MB=20

# Keep private: public tunnel visitors will not use the owner's CNKI session.
ALLOW_SHARED_CNKI=false

# Optional: CNKI CARSI/Shibboleth identity-provider entity ID for cnki-login.ps1.
# CNKI_IDP_ENTITY_ID=https://idp.example.edu.cn/idp/shibboleth

# Optional PostgreSQL URL for persistent jobs and report shares in the cloud.
DATABASE_URL=

# Optional contact e-mail; enables Crossref/OpenAlex polite pools and faster responses.
CONTACT_EMAIL=

